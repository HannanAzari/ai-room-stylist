# Koala AI Design Studio — environment template
# Copy this file to .env.local and fill in real values. Never commit real keys.

# OpenAI image generation (gpt-image-1). Required.
OPENAI_API_KEY=your-openai-api-key

# Google Gemini image generation (gemini-2.5-flash-image). Optional.
GEMINI_API_KEY=your-gemini-api-key

# Set to "true" to enable the Gemini image provider. Requires GEMINI_API_KEY.
ENABLE_GEMINI_IMAGE=false
