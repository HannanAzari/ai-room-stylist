# Koala AI Design Studio — environment template
# Copy this file to .env.local and fill in real values. Never commit real keys.

# ---------------------------------------------------------------------------
# Room editing renderer (the model that produces the generated room image)
# ---------------------------------------------------------------------------

# OpenAI. Required — GPT Image 2 is the default room-editing renderer.
OPENAI_API_KEY=your-openai-api-key

# Which renderer performs the room edit: "gpt-image" (default) or "gemini".
# The Gemini option exists so the two can be compared on identical inputs; it
# is not a production fallback. Unset or unrecognised values use the default.
ROOM_EDIT_PROVIDER=gpt-image

# Optional GPT Image tuning. Defaults shown; all three may be omitted.
#   GPT_IMAGE_MODEL   pin a dated snapshot to bisect a render regression
#   GPT_IMAGE_SIZE    landscape by default — rooms are photographed wide
#   GPT_IMAGE_QUALITY "low" | "medium" | "high" | "auto"
# GPT_IMAGE_MODEL=gpt-image-2
# GPT_IMAGE_SIZE=1536x1024
# GPT_IMAGE_QUALITY=high

# ---------------------------------------------------------------------------
# Room understanding (scene graph + quality reviewer)
# ---------------------------------------------------------------------------

# Google Gemini. Required — the scene analysis and the post-generation quality
# reviewer run on Gemini regardless of which renderer draws the image. These
# read images to build and grade the plan; they never render one.
GEMINI_API_KEY=your-gemini-api-key

# Legacy /api/generate-room route only: enables its optional Gemini image
# provider alongside its OpenAI one. Does NOT affect the studio flow, whose
# renderer is chosen by ROOM_EDIT_PROVIDER above.
ENABLE_GEMINI_IMAGE=false

# ---------------------------------------------------------------------------
# Debug
# ---------------------------------------------------------------------------

# Set to "true" to expose AI debug tooling (room analysis, prompts, quality
# scores) in the hidden admin view (?admin=1). Keep false in production.
#
# Also enables a per-image metadata log for every GPT Image request — input
# number, role, claimed vs detected format, dimensions, colour space, channels,
# depth, byte sizes. Metadata only; never image contents. This is what
# identifies "image 1" if the endpoint rejects a request.
ENABLE_AI_DEBUG=false

# --- Async generation jobs -------------------------------------------------
# A render takes 2-3 minutes. The studio starts it as a background job and
# polls for the result, so a refresh (or iOS Safari discarding a backgrounded
# tab) no longer throws away a render the customer has already paid for.
#
# Restore-on-refresh REQUIRES a durable job store. Add a Vercel KV / Upstash
# integration and these are set for you; either naming convention works.
# Without them the app falls back to an in-process store, which still works
# locally but is NOT durable on serverless — the UI detects this and simply
# does not promise a resume, rather than hanging on one it cannot deliver.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Or, with a direct Upstash integration:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Generation attempts per stage. Default 1.
# Was hard-coded to 2 (one render plus a retry when the reviewer flagged a
# contract failure), which across two stages meant up to FOUR sequential GPT
# Image renders plus a review each — most of the 2-3 minute wait. Set to 2 to
# restore the old behaviour; values are clamped to 1-3.
GENERATION_ATTEMPTS_PER_STAGE=1
